<?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
    <suite name="All Pet Store Tests" parallel="tests" thread-count="2">
    
    <test name="Negative Login Tests">
        <parameter name="browser" value="CHROME"></parameter>
        <classes>
            <class name="Temat9.tests.FailedLoginTests"></class>
        </classes>
    </test>
    
    <test name="Positive Login Tests">
        <parameter name="browser" value="CHROME"></parameter>
        <classes>
            <class name="Temat9.tests.PositiveLoginTests"></class>
        </classes>
    </test>

</suite>