<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >

<suite name="Login Tests" >
    <test name="Login Test Without Credentials">
        <parameter name="username" value=""/>
        <parameter name="password" value=""/>
        <parameter name="expectedWarning" value="Your username is invalid!"/>
        <classes>
            <class name="Temat14.LoginTests"/>
        </classes>
    </test>

    <test name="Login Test With Incorrect Password">
        <parameter name="username" value="tomsmith"/>
        <parameter name="password" value="password"/>
        <parameter name="expectedWarning" value="Your password is invalid!"/>
        <classes>
            <class name="Temat14.LoginTests"/>
        </classes>
    </test>

    <test name="Login Test With Incorrect Login">
        <parameter name="username" value="incorrectlogin"/>
        <parameter name="password" value="SuperSecretPassword!"/>
        <parameter name="expectedWarning" value="Your username is invalid!"/>
        <classes>
            <class name="Temat14.LoginTests"/>
        </classes>
    </test>
</suite>